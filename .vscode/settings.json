{
	// Bez těchto stubů hlásí Intelephense funkce jako random_bytes() nebo
	// sodium_* za nedefinované — PHP je totiž nejdřív hledá ve jmenném prostoru
	// (Pina\Auth\random_bytes) a teprve pak spadne zpět na globální.
	"intelephense.stubs": [
		"Core",
		"standard",
		"random",
		"sodium",
		"PDO",
		"mysqli",
		"json",
		"mbstring",
		"intl",
		"curl",
		"openssl",
		"hash",
		"date",
		"filter",
		"pcre",
		"SPL",
		"Reflection",
		"session",
		"fileinfo",
		"gd",
		"zip",
		"bcmath",
		"gmp"
	],
	"intelephense.environment.phpVersion": "8.5.0",
	"php.validate.enable": false,

	"[php]": {
		"editor.insertSpaces": true,
		"editor.tabSize": 4,
		"editor.detectIndentation": false
	},
	"files.trimTrailingWhitespace": true,
	"files.insertFinalNewline": true
}
