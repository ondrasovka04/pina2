# Zkopíruj jako .env a doplň hodnoty. Soubor .env NIKDY nepatří do gitu.

APP_ENV=local            # local | production
APP_URL=http://localhost:5173
APP_DEBUG=true           # v produkci vždy false

DB_HOST=db
DB_NAME=pina
DB_USER=pina
DB_PASSWORD=pina

# Podpis JWT. Vygeneruj: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_ACCESS_TTL=900       # 15 minut
JWT_REFRESH_TTL=2592000  # 30 dní

# Odesílání e-mailů. Dokud je MAIL_ENABLED=false, žádná pošta neodejde --
# zprávy se jen zapíšou do logu. Zapnout až těsně před spuštěním.
MAIL_ENABLED=false

# Posílá se přes SMTP Zoneru, ne přes lokální mail(). Důvod: SPF domény
# (v=spf1 include:spf-zoner-zmail.zoner.com) pokrývá jejich mailové servery
# a ty zprávu zároveň podepíší DKIM. U pošty odeslané přímo z webhostingu
# tuhle jistotu nemáme a skončila by ve spamu.
MAIL_HOST=smtp.zoner.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl        # 465 = ssl, 587 = tls
MAIL_USERNAME=pina@pinaprosek.eu
MAIL_PASSWORD=
MAIL_FROM=pina@pinaprosek.eu
MAIL_FROM_NAME="Pína"

# Web Push (VAPID). Vygeneruje se až ve fázi F5.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:webmaster@pinaprosek.eu

# Token pro úlohy spouštěné plánovačem Zoneru (URL musí obsahovat ?token=...)
CRON_TOKEN=
